# Copy to .env.local and fill in. Never commit real values.
# Demo mode needs none of these. After changing them, run `npm run build` again.

# Supabase (Project Settings → API): the project URL and the public key
# (labelled "anon public", or "Publishable key" on newer projects).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API (console.anthropic.com → API Keys). Set a monthly spend limit there too.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
