# Copy to .env.local for running on your computer, or add these as Environment
# Variables in your Vercel project. Never commit real values.
# The demo needs none of these; only AI tagging of your own photos does.

# Claude API key (console.anthropic.com → API Keys). Set a monthly spend limit there too.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# A passcode only you know. The app asks for it once per phone, so strangers
# who find your site can't spend your AI credits. Use something long.
APP_PASSCODE=
